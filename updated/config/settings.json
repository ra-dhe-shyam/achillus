  "allow_cloud_fallback": false,
  "allow_cloud_memory_context": false,
  "start_chat_by_default": true,
  "audio_sample_rate": 16000,
  "audio_record_seconds": 6,
  "audio_capture_device": "default",
  "audio_playback_device": "default",
  "vosk_model_path": "",
  "piper_model_path": "",
  "audio_vad_rms_threshold": 450,
  "audio_vad_silence_seconds": 1.0,
  "audio_max_utterance_seconds": 12,
  "audio_wake_phrase": "achillus"
}
