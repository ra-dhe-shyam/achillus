{
  "service_name": "personal-ai",
  "version": "0.1.0",
  "offline_first": true,
  "store_raw_audio": false,
  "log_level": "INFO",
  "model_backend": "hybrid",
  "ollama_url": "http://127.0.0.1:11434",
  "ollama_model": "qwen2.5:1.5b",
  "ollama_timeout_seconds": 120,
