"""Bounded tool orchestration using provider-native tool calls when available."""
import json
import logging

from agent_tools import AgentTools, TOOL_SPECS
from model_interface import _messages

logger = logging.getLogger("personal_ai.cognition")
MAX_STEPS = 1	


class CognitiveLoop:
    """Let the provider request allowlisted tools; execute and return observations."""

    def __init__(self, model, max_steps=MAX_STEPS, tool_registry=None):
        if isinstance(max_steps, bool) or not isinstance(max_steps, int) or not 1 <= max_steps <= 8:
            raise ValueError("max_steps must be an integer between 1 and 8")
        self.model = model
        self.max_steps = max_steps
        self.agent_tools = AgentTools()
        self.tools = tool_registry or self.agent_tools.registry

    @staticmethod
    def _tool_schemas(registry):
        permitted = set(registry)
        return [item for item in TOOL_SPECS if item["function"]["name"] in permitted]

    def run(self, user_message, memories):
        """Answer directly first; execute provider-requested tools when needed."""
        original_message = user_message.strip()

        if not original_message:
            return "Please enter a message."

        # The first model request contains the actual user message and memory.
        # Providers without native tool support retain the direct-answer path.
        generate_with_tools = getattr(self.model, "generate_with_tools", None)

        if not callable(generate_with_tools):
            return self.model.generate(original_message, memories).strip()

        messages = _messages(original_message, memories)
        tool_schemas = self._tool_schemas(self.tools)

        for _ in range(self.max_steps):
            response = generate_with_tools(messages, tool_schemas)

            if not isinstance(response, dict):
                raise ValueError("Model returned an invalid tool response")

            response_type = response.get("type")

            if response_type == "final":
                content = response.get("content", "")
                if not isinstance(content, str) or not content.strip():
                    raise ValueError("Model returned an empty final response")
                return content.strip()

            if response_type != "tool_call":
                raise ValueError("Model returned an unknown response type")

            name = response.get("name")
            arguments = response.get("arguments")

            # Only execute tools explicitly registered as permitted.
            if name not in self.tools:
                raise ValueError(f"Model requested an unapproved tool: {name}")

            if not isinstance(arguments, dict):
                raise ValueError("Model returned invalid tool arguments")

            assistant_message = response.get("assistant_message")
            if not isinstance(assistant_message, dict):
                raise ValueError("Tool call is missing its assistant message")

            messages.append(assistant_message)

            try:
                result = self.tools[name](arguments)
            except Exception as exc:
                logger.exception("Tool execution failed: %s", name)
                result = {"error": f"Tool execution failed: {type(exc).__name__}"}

            messages.append(
                self.model.tool_result_message(response, result)
            )

        # Do not silently substitute a generic answer after exhausting steps.
        return "I reached the tool-use limit before completing the request."
